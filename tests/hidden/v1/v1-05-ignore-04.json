{
  "name": "v1-05-ignore-04: an anchored pattern matches only at the root",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": ".gitignore",
      "content": "/only-root\n"
    },
    {
      "write": "only-root",
      "content": "r\n"
    },
    {
      "write": "src/only-root",
      "content": "s\n"
    },
    {
      "run": [
        "ls-files",
        "-o",
        "--exclude-standard"
      ],
      "matchOutput": true
    }
  ]
}
