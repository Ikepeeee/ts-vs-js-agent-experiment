{
  "name": "v1-04-objects-15: trees written by tgit use git's entry order",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "a-b",
      "content": "1\n"
    },
    {
      "write": "a/x",
      "content": "2\n"
    },
    {
      "write": "a.b",
      "content": "3\n"
    },
    {
      "write": "a0",
      "content": "4\n"
    },
    {
      "write": "ab/c",
      "content": "5\n"
    },
    {
      "write": "a_",
      "content": "6\n"
    },
    {
      "run": [
        "add",
        "."
      ]
    },
    {
      "run": [
        "commit",
        "-m",
        "ordering"
      ]
    }
  ]
}
