{
  "name": "v1-02-dispatch-03: repository is found from a nested subdirectory",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "mkdir": "src/lib/deep/er"
    },
    {
      "run": [
        "cat-file",
        "-t",
        "HEAD"
      ],
      "matchOutput": true,
      "cwd": "src/lib/deep/er"
    }
  ]
}
