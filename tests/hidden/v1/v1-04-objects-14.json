{
  "name": "v1-04-objects-14: cat-file on an annotated tag object",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "git": [
        "tag",
        "-a",
        "v1.0",
        "-m",
        "Release 1.0"
      ]
    },
    {
      "run": [
        "cat-file",
        "-t",
        "v1.0"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "cat-file",
        "-p",
        "v1.0"
      ],
      "matchOutput": true
    }
  ]
}
