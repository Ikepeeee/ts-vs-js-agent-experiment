{
  "name": "v1-04-objects-11: cat-file -s of a blob and a commit",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "run": [
        "cat-file",
        "-s",
        "6e5bb8244484b1590447f00cdac9fe9977c14b4a"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "cat-file",
        "-s",
        "HEAD"
      ],
      "matchOutput": true
    }
  ]
}
