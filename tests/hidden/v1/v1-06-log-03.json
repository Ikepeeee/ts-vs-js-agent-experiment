{
  "name": "v1-06-log-03: a multi-paragraph message",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "x.txt",
      "content": "x\n"
    },
    {
      "git": [
        "add",
        "x.txt"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Subject",
        "-m",
        "First paragraph\nwith two lines.",
        "-m",
        "Second paragraph."
      ]
    },
    {
      "run": [
        "log",
        "--oneline"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "log",
        "-n",
        "1"
      ],
      "matchOutput": true
    }
  ]
}
