{
  "name": "v1-05-ignore-03: a directory pattern",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": ".gitignore",
      "content": "build/\n"
    },
    {
      "write": "build/out.js",
      "content": "o\n"
    },
    {
      "write": "src/build/gen.js",
      "content": "g\n"
    },
    {
      "write": "src/main.js",
      "content": "m\n"
    },
    {
      "run": [
        "status",
        "--porcelain"
      ],
      "matchOutput": true
    }
  ]
}
