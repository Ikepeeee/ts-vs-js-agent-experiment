{
  "name": "v1-05-ignore-01: comments and blank lines",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": ".gitignore",
      "content": "# comment\n\n*.bak\n\n# another\n"
    },
    {
      "write": "x.bak",
      "content": "x\n"
    },
    {
      "write": "# comment",
      "content": "not ignored\n"
    },
    {
      "write": "y.txt",
      "content": "y\n"
    },
    {
      "run": [
        "status",
        "--porcelain"
      ],
      "matchOutput": true
    }
  ]
}
