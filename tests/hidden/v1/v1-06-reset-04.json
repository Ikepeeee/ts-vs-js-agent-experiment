{
  "name": "v1-06-reset-04: reset -- path unstages a file",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "README.md",
      "content": "staged\n"
    },
    {
      "write": "new.txt",
      "content": "n\n"
    },
    {
      "git": [
        "add",
        "."
      ]
    },
    {
      "run": [
        "reset",
        "--",
        "README.md",
        "new.txt"
      ]
    }
  ]
}
