{
  "name": "v1-05-add-03: add -u stages only tracked files",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "src/app.js",
      "content": "console.log('bye');\n"
    },
    {
      "delete": "README.md"
    },
    {
      "write": "untracked.txt",
      "content": "u\n"
    },
    {
      "run": [
        "add",
        "-u"
      ]
    }
  ]
}
