{
  "name": "v1-06-branch-03: -D of an unmerged branch",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "-c",
        "topic"
      ]
    },
    {
      "write": "t.txt",
      "content": "t\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "topic work"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "main"
      ]
    },
    {
      "run": [
        "branch",
        "-D",
        "topic"
      ]
    },
    {
      "run": [
        "branch"
      ],
      "matchOutput": true
    }
  ]
}
