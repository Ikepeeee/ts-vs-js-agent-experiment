{
  "name": "v1-05-ls-files-05: ls-files quotes special paths",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "with space.txt",
      "content": "x\n"
    },
    {
      "write": "日本語.txt",
      "content": "x\n"
    },
    {
      "write": "-dash.txt",
      "content": "x\n"
    },
    {
      "write": "tab\there",
      "content": "t\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "c"
      ]
    },
    {
      "run": [
        "ls-files"
      ],
      "matchOutput": true
    }
  ]
}
