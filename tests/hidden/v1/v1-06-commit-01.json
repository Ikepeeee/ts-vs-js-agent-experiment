{
  "name": "v1-06-commit-01: repeated -m become paragraphs",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "a.txt",
      "content": "a\n"
    },
    {
      "git": [
        "add",
        "a.txt"
      ]
    },
    {
      "run": [
        "commit",
        "-m",
        "Subject line",
        "-m",
        "Body paragraph one.",
        "-m",
        "Body paragraph two."
      ]
    }
  ]
}
