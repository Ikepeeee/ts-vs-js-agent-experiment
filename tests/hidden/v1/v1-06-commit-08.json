{
  "name": "v1-06-commit-08: commit from a subdirectory",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "src/new.js",
      "content": "n\n"
    },
    {
      "git": [
        "add",
        "new.js"
      ],
      "cwd": "src"
    },
    {
      "run": [
        "commit",
        "-m",
        "From a subdirectory"
      ],
      "cwd": "src/lib"
    }
  ]
}
