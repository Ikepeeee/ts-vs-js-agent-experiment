{
  "name": "v1-06-switch-05: switching changes modes and symlinks",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "tool",
      "content": "#!/bin/sh\n"
    },
    {
      "write": "target.txt",
      "content": "t\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "plain"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "-c",
        "modes"
      ]
    },
    {
      "chmod": "tool",
      "mode": "755"
    },
    {
      "symlink": "link",
      "target": "target.txt"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "exec and link"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "main"
      ]
    },
    {
      "run": [
        "switch",
        "modes"
      ]
    },
    {
      "run": [
        "switch",
        "main"
      ]
    }
  ]
}
