{
  "name": "v1-04-objects-16: trees written by tgit use git's modes",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "plain.txt",
      "content": "p\n"
    },
    {
      "write": "tool.sh",
      "content": "#!/bin/sh\n"
    },
    {
      "chmod": "tool.sh",
      "mode": "755"
    },
    {
      "symlink": "alias",
      "target": "plain.txt"
    },
    {
      "write": "dir/inner.txt",
      "content": "i\n"
    },
    {
      "run": [
        "add",
        "."
      ]
    },
    {
      "run": [
        "commit",
        "-m",
        "modes"
      ]
    }
  ]
}
