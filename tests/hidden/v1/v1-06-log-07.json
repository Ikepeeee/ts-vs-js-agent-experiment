{
  "name": "v1-06-log-07: path limiting from a subdirectory",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\nNow with more text.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Expand README"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "write": "notes.txt",
      "content": "note 1\n"
    },
    {
      "git": [
        "add",
        "-A"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000120 +0000",
        "GIT_COMMITTER_DATE": "1700000120 +0000"
      }
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Add notes"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000120 +0000",
        "GIT_COMMITTER_DATE": "1700000120 +0000"
      }
    },
    {
      "write": "src/x.js",
      "content": "x\n"
    },
    {
      "git": [
        "add",
        "-A"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000180 +0000",
        "GIT_COMMITTER_DATE": "1700000180 +0000"
      }
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Add x"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000180 +0000",
        "GIT_COMMITTER_DATE": "1700000180 +0000"
      }
    },
    {
      "run": [
        "log",
        "--oneline",
        "--",
        "."
      ],
      "matchOutput": true,
      "cwd": "src"
    },
    {
      "run": [
        "log",
        "--oneline",
        "--",
        "../README.md"
      ],
      "matchOutput": true,
      "cwd": "src"
    }
  ]
}
