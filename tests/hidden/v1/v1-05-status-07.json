{
  "name": "v1-05-status-07: status --porcelain from a subdirectory",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "src/new.js",
      "content": "n\n"
    },
    {
      "write": "top.txt",
      "content": "t\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "edited\n"
    },
    {
      "run": [
        "status",
        "--porcelain"
      ],
      "matchOutput": true,
      "cwd": "src"
    }
  ]
}
