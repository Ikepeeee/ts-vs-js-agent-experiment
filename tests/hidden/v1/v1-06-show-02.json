{
  "name": "v1-06-show-02: show -s with a multi-paragraph message and non-ASCII author",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "y.txt",
      "content": "y\n"
    },
    {
      "git": [
        "add",
        "y.txt"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Title",
        "-m",
        "Body text\nwraps here."
      ],
      "env": {
        "GIT_AUTHOR_NAME": "Jürgen Ågren"
      }
    },
    {
      "run": [
        "show",
        "-s",
        "HEAD"
      ],
      "matchOutput": true
    }
  ]
}
