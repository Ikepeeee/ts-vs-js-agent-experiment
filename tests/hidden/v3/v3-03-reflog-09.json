{
  "name": "v3-03-reflog-09: the first commit in a new repository",
  "steps": [
    {
      "run": [
        "init",
        "-q"
      ]
    },
    {
      "write": "a.txt",
      "content": "a\n"
    },
    {
      "run": [
        "add",
        "a.txt"
      ]
    },
    {
      "run": [
        "commit",
        "-m",
        "First"
      ]
    },
    {
      "run": [
        "reflog"
      ],
      "matchOutput": true
    }
  ]
}
