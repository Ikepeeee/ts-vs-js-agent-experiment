{
  "name": "v3-03-revert-03: revert a commit with a multi-paragraph message",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "x.txt",
      "content": "x\n"
    },
    {
      "git": [
        "add",
        "x.txt"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Add x",
        "-m",
        "Because we needed it."
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "run": [
        "revert",
        "--no-edit",
        "HEAD"
      ]
    },
    {
      "run": [
        "cat-file",
        "-p",
        "HEAD"
      ],
      "matchOutput": true
    }
  ]
}
