{
  "name": "v3-03-reflog-01: the first commit and an amend",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "a.txt",
      "content": "a\n"
    },
    {
      "git": [
        "add",
        "a.txt"
      ]
    },
    {
      "run": [
        "commit",
        "-m",
        "Initial"
      ]
    },
    {
      "run": [
        "commit",
        "--amend",
        "-m",
        "Initial (amended)"
      ]
    },
    {
      "run": [
        "reflog"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "reflog",
        "show",
        "main"
      ],
      "matchOutput": true
    }
  ]
}
