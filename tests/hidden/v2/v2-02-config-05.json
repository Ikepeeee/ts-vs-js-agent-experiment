{
  "name": "v2-02-config-05: subsections",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "run": [
        "config",
        "branch.main.description",
        "the main line"
      ]
    },
    {
      "run": [
        "config",
        "remote.origin.url",
        "https://example.com/repo.git"
      ]
    },
    {
      "run": [
        "config",
        "my.Sub Section.key",
        "v"
      ]
    },
    {
      "run": [
        "config",
        "branch.main.description"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "config",
        "my.Sub Section.key"
      ],
      "matchOutput": true
    }
  ]
}
