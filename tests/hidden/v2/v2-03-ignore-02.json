{
  "name": "v2-03-ignore-02: a leading ** pattern",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": ".gitignore",
      "content": "**/tmp\n"
    },
    {
      "write": "tmp/a",
      "content": "1\n"
    },
    {
      "write": "src/tmp/b",
      "content": "2\n"
    },
    {
      "write": "src/lib/tmp",
      "content": "3\n"
    },
    {
      "write": "src/keep",
      "content": "k\n"
    },
    {
      "run": [
        "ls-files",
        "-o",
        "--exclude-standard"
      ],
      "matchOutput": true
    }
  ]
}
