      "contentBase64": "AAECdA=="
    },
    {
      "git": [
        "add",
        "-A"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Topic binary"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "git": [
        "switch",
        "-q",
        "main"
