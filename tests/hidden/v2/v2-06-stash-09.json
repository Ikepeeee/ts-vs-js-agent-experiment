{
  "name": "v2-06-stash-09: pop that conflicts with a later commit keeps the entry",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "README.md",
      "content": "stashed version\n"
    },
    {
      "git": [
        "stash",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "committed version\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Change README"
      ]
    },
    {
      "run": [
        "stash",
        "pop"
      ],
      "expectExit": 1
    },
    {
      "run": [
        "stash",
        "list"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "ls-files",
        "-s"
      ],
      "matchOutput": true
    }
  ]
}
