{
  "name": "v2-01-diff-05: diff with path limiting",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "README.md",
      "content": "r\n"
    },
    {
      "write": "src/app.js",
      "content": "a\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "u\n"
    },
    {
      "run": [
        "diff",
        "--",
        "src"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "diff",
        "--",
        "README.md",
        "src/lib"
      ],
      "matchOutput": true
    }
  ]
}
