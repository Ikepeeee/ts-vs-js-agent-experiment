{
  "name": "v2-03-ignore-04: a .gitignore in a subdirectory overrides the root one",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": ".gitignore",
      "content": "*.gen\n"
    },
    {
      "write": "src/.gitignore",
      "content": "!keep.gen\nlocal.txt\n"
    },
    {
      "write": "a.gen",
      "content": "1\n"
    },
    {
      "write": "src/keep.gen",
      "content": "2\n"
    },
    {
      "write": "src/other.gen",
      "content": "3\n"
    },
    {
      "write": "src/local.txt",
      "content": "4\n"
    },
    {
      "write": "local.txt",
      "content": "5\n"
    },
    {
      "run": [
        "ls-files",
        "-o",
        "--exclude-standard"
      ],
      "matchOutput": true
    }
  ]
}
