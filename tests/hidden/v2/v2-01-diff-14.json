{
  "name": "v2-01-diff-14: repeated lines make the match ambiguous",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "blocks.txt",
      "content": "{\n  x\n}\n{\n  y\n}\n{\n  z\n}\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "initial"
      ]
    },
    {
      "write": "blocks.txt",
      "content": "{\n  x\n}\n{\n  new\n}\n{\n  y\n}\n{\n  z\n}\n"
    },
    {
      "run": [
        "diff"
      ],
      "matchOutput": true
    },
    {
      "write": "blocks.txt",
      "content": "{\n  y\n}\n{\n  x\n}\n{\n  z\n}\n"
    },
    {
      "run": [
        "diff"
      ],
      "matchOutput": true
    }
  ]
}
