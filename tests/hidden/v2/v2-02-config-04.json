{
  "name": "v2-02-config-04: values with spaces, quotes, and #",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "run": [
        "config",
        "my.spaced",
        "two  words "
      ]
    },
    {
      "run": [
        "config",
        "my.quoted",
        "say \"hi\""
      ]
    },
    {
      "run": [
        "config",
        "my.hash",
        "a#b ; c"
      ]
    },
    {
      "run": [
        "config",
        "my.back",
        "back\\slash"
      ]
    },
    {
      "run": [
        "config",
        "my.spaced"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "config",
        "my.quoted"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "config",
        "my.hash"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "config",
        "my.back"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "config",
        "--list"
      ],
      "matchOutput": true
    }
  ]
}
