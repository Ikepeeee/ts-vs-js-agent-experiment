{
  "name": "v2-03-ignore-05: .git/info/exclude",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": ".git/info/exclude",
      "content": "secret.txt\n*.swp\n"
    },
    {
      "write": "secret.txt",
      "content": "s\n"
    },
    {
      "write": "src/x.swp",
      "content": "x\n"
    },
    {
      "write": "ok.txt",
      "content": "o\n"
    },
    {
      "run": [
        "status",
        "--porcelain"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "add",
        "secret.txt"
      ],
      "expectExit": 1
    }
  ]
}
