{
  "name": "v2-06-stash-05: staged and unstaged changes",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "staged.txt",
      "content": "new and staged\n"
    },
    {
      "git": [
        "add",
        "staged.txt"
      ]
    },
    {
      "write": "README.md",
      "content": "staged edit\n"
    },
    {
      "git": [
        "add",
        "README.md"
      ]
    },
    {
      "write": "README.md",
      "content": "unstaged edit on top\n"
    },
    {
      "run": [
        "stash",
        "push"
      ]
    },
    {
      "run": [
        "cat-file",
        "-p",
        "refs/stash"
      ],
      "matchOutput": true
    },
    {
      "run": [
        "stash",
        "pop"
      ]
    },
    {
      "run": [
        "status",
        "--porcelain"
      ],
      "matchOutput": true
    }
  ]
}
