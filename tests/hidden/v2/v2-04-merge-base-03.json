{
  "name": "v2-04-merge-base-03: --all with criss-cross history",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "f.txt",
      "content": "base\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Base"
      ]
    },
    {
      "git": [
        "branch",
        "b"
      ]
    },
    {
      "write": "a1.txt",
      "content": "1\n"
    },
    {
      "git": [
        "add",
        "-A"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "A1"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000060 +0000",
        "GIT_COMMITTER_DATE": "1700000060 +0000"
      }
    },
    {
      "git": [
        "switch",
        "-q",
        "b"
      ]
    },
    {
      "write": "b1.txt",
      "content": "1\n"
    },
    {
      "git": [
        "add",
        "-A"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000120 +0000",
        "GIT_COMMITTER_DATE": "1700000120 +0000"
      }
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "B1"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000120 +0000",
        "GIT_COMMITTER_DATE": "1700000120 +0000"
      }
    },
    {
      "git": [
        "branch",
        "b-at-b1"
      ]
    },
    {
      "git": [
        "merge",
        "-q",
        "--no-ff",
        "-m",
        "Merge A1 into b",
        "main"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000180 +0000",
        "GIT_COMMITTER_DATE": "1700000180 +0000"
      }
    },
    {
      "git": [
        "switch",
        "-q",
        "main"
      ]
    },
    {
      "git": [
        "merge",
        "-q",
        "--no-ff",
        "-m",
        "Merge B1 into main",
        "b-at-b1"
      ],
      "env": {
        "GIT_AUTHOR_DATE": "1700000240 +0000",
        "GIT_COMMITTER_DATE": "1700000240 +0000"
      }
    },
    {
      "run": [
        "merge-base",
        "--all",
        "main",
        "b"
      ],
      "matchOutput": true
    }
  ]
}
