{
  "name": "v2-01-diff-15: rewriting a whole file",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "poem.txt",
      "content": "old verse 1\nold verse 2\nold verse 3\nold verse 4\nold verse 5\nold verse 6\nold verse 7\nold verse 8\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "initial"
      ]
    },
    {
      "write": "poem.txt",
      "content": "new verse 1\nnew verse 2\nnew verse 3\nnew verse 4\nnew verse 5\nnew verse 6\n"
    },
    {
      "run": [
        "diff"
      ],
      "matchOutput": true
    }
  ]
}
