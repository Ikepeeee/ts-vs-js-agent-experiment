{
  "name": "v2-06-stash-08: stash a deleted file",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "delete": "docs/guide.txt"
    },
    {
      "git": [
        "rm",
        "-q",
        "--cached",
        "src/app.js"
      ]
    },
    {
      "run": [
        "stash",
        "push"
      ]
    },
    {
      "run": [
        "stash",
        "pop"
      ]
    },
    {
      "run": [
        "status",
        "--porcelain"
      ],
      "matchOutput": true
    }
  ]
}
