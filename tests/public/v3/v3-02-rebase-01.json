{
  "name": "v3-02-rebase-01: rebase onto an upstream branch",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Base"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "-c",
        "topic"
      ]
    },
    {
      "write": "topic.txt",
      "content": "topic 1\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "T1: add topic.txt"
      ]
    },
    {
      "write": "src/app.js",
      "content": "console.log('topic');\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "T2: change app"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "main"
      ]
    },
    {
      "write": "main.txt",
      "content": "main 1\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "M1: add main.txt"
      ]
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\nMain edit.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "M2: edit guide"
      ]
    },
    {
      "git": [
        "switch",
        "-q",
        "topic"
      ]
    },
    {
      "run": [
        "rebase",
        "main"
      ]
    }
  ]
}
