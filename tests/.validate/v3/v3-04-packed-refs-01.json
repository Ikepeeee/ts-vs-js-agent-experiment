{
  "name": "v3-04-packed-refs-01: resolve a ref stored in packed-refs",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\nNow with more text.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Expand README"
      ]
    },
    {
      "write": "notes.txt",
      "content": "note 1\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Add notes"
      ]
    },
    {
      "git": [
        "branch",
        "feature",
        "HEAD~1"
      ]
    },
    {
      "git": [
        "pack-refs",
        "--all"
      ]
    },
    {
      "run": [
        "rev-parse",
        "feature",
        "main"
      ],
      "matchOutput": true
    }
  ]
}
