{
  "name": "v3-03-reflog-02: reflog show of a branch",
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ]
    },
    {
      "write": "README.md",
      "content": "# Demo\n\nA small project.\n"
    },
    {
      "write": "src/app.js",
      "content": "console.log('hello');\n"
    },
    {
      "write": "src/lib/util.js",
      "content": "export const add = (a, b) => a + b;\n"
    },
    {
      "write": "docs/guide.txt",
      "content": "Read me first.\n"
    },
    {
      "git": [
        "add",
        "-A"
      ]
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "Initial commit"
      ]
    },
    {
      "write": "a.txt",
      "content": "a\n"
    },
    {
      "run": [
        "add",
        "a.txt"
      ]
    },
    {
      "run": [
        "commit",
        "-m",
        "Add a"
      ]
    },
    {
      "run": [
        "reflog",
        "show",
        "main"
      ],
      "matchOutput": true
    }
  ]
}
